{
  "annotations": [
    {
      "kind": "AnnotationQuery",
      "spec": {
        "builtIn": true,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "query": {
          "datasource": { "name": "-- Grafana --" },
          "group": "grafana",
          "kind": "DataQuery",
          "spec": {},
          "version": "v0"
        }
      }
    }
  ],
  "cursorSync": "Off",
  "editable": true,
  "title": "ObRail Europe — Monitoring",
  "tags": ["obrail", "monitoring"],
  "liveNow": false,
  "preload": false,
  "variables": [],
  "links": [],
  "timeSettings": {
    "autoRefresh": "10s",
    "autoRefreshIntervals": ["5s","10s","30s","1m","5m","15m","30m","1h","2h","1d"],
    "fiscalYearStartMonth": 0,
    "from": "now-1h",
    "hideTimepicker": false,
    "timezone": "browser",
    "to": "now"
  },
  "elements": {
    "panel-1": {
      "kind": "Panel",
      "spec": {
        "id": 1,
        "title": "🟢 API Status",
        "description": "UP = API disponible / DOWN = API hors ligne",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [{
              "kind": "PanelQuery",
              "spec": {
                "hidden": false,
                "refId": "A",
                "query": {
                  "datasource": { "name": "Prometheus" },
                  "group": "prometheus",
                  "kind": "DataQuery",
                  "version": "v0",
                  "spec": {
                    "expr": "up{job=\"obrail_api\"}",
                    "legendFormat": "ObRail API",
                    "instant": false,
                    "range": true,
                    "editorMode": "code"
                  }
                }
              }
            }],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "stat",
          "version": "13.0.1+security-01",
          "spec": {
            "options": {
              "colorMode": "background",
              "graphMode": "none",
              "textMode": "value_and_name",
              "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
            },
            "fieldConfig": {
              "defaults": {
                "mappings": [{ "type": "value", "options": { "0": {"text":"DOWN","color":"red"}, "1": {"text":"UP","color":"green"} } }],
                "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":0},{"color":"green","value":1}] },
                "color": { "mode": "thresholds" }
              },
              "overrides": []
            }
          }
        }
      }
    },
    "panel-2": {
      "kind": "Panel",
      "spec": {
        "id": 2,
        "title": "📊 Total Requêtes API",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [{
              "kind": "PanelQuery",
              "spec": {
                "hidden": false,
                "refId": "A",
                "query": {
                  "datasource": { "name": "Prometheus" },
                  "group": "prometheus",
                  "kind": "DataQuery",
                  "version": "v0",
                  "spec": {
                    "expr": "sum(http_requests_total{job=\"obrail_api\"})",
                    "legendFormat": "Total",
                    "instant": false,
                    "range": true,
                    "editorMode": "code"
                  }
                }
              }
            }],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "stat",
          "version": "13.0.1+security-01",
          "spec": {
            "options": {
              "colorMode": "background",
              "graphMode": "area",
              "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
            },
            "fieldConfig": {
              "defaults": {
                "color": { "fixedColor": "blue", "mode": "fixed" },
                "unit": "short"
              },
              "overrides": []
            }
          }
        }
      }
    },
    "panel-3": {
      "kind": "Panel",
      "spec": {
        "id": 3,
        "title": "⚡ Requêtes / seconde",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [{
              "kind": "PanelQuery",
              "spec": {
                "hidden": false,
                "refId": "A",
                "query": {
                  "datasource": { "name": "Prometheus" },
                  "group": "prometheus",
                  "kind": "DataQuery",
                  "version": "v0",
                  "spec": {
                    "expr": "sum(rate(http_requests_total{job=\"obrail_api\"}[1m]))",
                    "legendFormat": "req/s",
                    "instant": false,
                    "range": true,
                    "editorMode": "code"
                  }
                }
              }
            }],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "stat",
          "version": "13.0.1+security-01",
          "spec": {
            "options": {
              "colorMode": "background",
              "graphMode": "area",
              "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
            },
            "fieldConfig": {
              "defaults": {
                "color": { "fixedColor": "green", "mode": "fixed" },
                "unit": "reqps",
                "decimals": 2
              },
              "overrides": []
            }
          }
        }
      }
    },
    "panel-4": {
      "kind": "Panel",
      "spec": {
        "id": 4,
        "title": "⏱ Latence Moyenne (ms)",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [{
              "kind": "PanelQuery",
              "spec": {
                "hidden": false,
                "refId": "A",
                "query": {
                  "datasource": { "name": "Prometheus" },
                  "group": "prometheus",
                  "kind": "DataQuery",
                  "version": "v0",
                  "spec": {
                    "expr": "sum(rate(http_request_duration_seconds_sum{job=\"obrail_api\"}[1m])) / sum(rate(http_request_duration_seconds_count{job=\"obrail_api\"}[1m])) * 1000",
                    "legendFormat": "latence ms",
                    "instant": false,
                    "range": true,
                    "editorMode": "code"
                  }
                }
              }
            }],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "stat",
          "version": "13.0.1+security-01",
          "spec": {
            "options": {
              "colorMode": "background",
              "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
            },
            "fieldConfig": {
              "defaults": {
                "unit": "ms",
                "decimals": 0,
                "color": { "mode": "thresholds" },
                "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":0},{"color":"yellow","value":200},{"color":"red","value":500}] }
              },
              "overrides": []
            }
          }
        }
      }
    },
    "panel-5": {
      "kind": "Panel",
      "spec": {
        "id": 5,
        "title": "📈 Requêtes par endpoint",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [{
              "kind": "PanelQuery",
              "spec": {
                "hidden": false,
                "refId": "A",
                "query": {
                  "datasource": { "name": "Prometheus" },
                  "group": "prometheus",
                  "kind": "DataQuery",
                  "version": "v0",
                  "spec": {
                    "expr": "sum by(handler) (rate(http_requests_total{job=\"obrail_api\"}[1m]))",
                    "legendFormat": "{{handler}}",
                    "instant": false,
                    "range": true,
                    "editorMode": "code"
                  }
                }
              }
            }],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "timeseries",
          "version": "13.0.1+security-01",
          "spec": {
            "options": {
              "tooltip": { "mode": "multi", "sort": "none" },
              "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean","max"] }
            },
            "fieldConfig": {
              "defaults": {
                "unit": "reqps",
                "color": { "mode": "palette-classic" },
                "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "line", "lineInterpolation": "smooth" }
              },
              "overrides": []
            }
          }
        }
      }
    },
    "panel-6": {
      "kind": "Panel",
      "spec": {
        "id": 6,
        "title": "🟢 Disponibilité dans le temps",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [{
              "kind": "PanelQuery",
              "spec": {
                "hidden": false,
                "refId": "A",
                "query": {
                  "datasource": { "name": "Prometheus" },
                  "group": "prometheus",
                  "kind": "DataQuery",
                  "version": "v0",
                  "spec": {
                    "expr": "up{job=\"obrail_api\"}",
                    "legendFormat": "ObRail API",
                    "instant": false,
                    "range": true,
                    "editorMode": "code"
                  }
                }
              }
            }],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "timeseries",
          "version": "13.0.1+security-01",
          "spec": {
            "options": {
              "tooltip": { "mode": "single", "sort": "none" },
              "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
            },
            "fieldConfig": {
              "defaults": {
                "color": { "mode": "thresholds" },
                "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":0},{"color":"green","value":1}] },
                "mappings": [{"type":"value","options":{"0":{"text":"DOWN"},"1":{"text":"UP"}}}],
                "custom": { "lineWidth": 2, "fillOpacity": 20, "drawStyle": "line" }
              },
              "overrides": []
            }
          }
        }
      }
    },
    "panel-7": {
      "kind": "Panel",
      "spec": {
        "id": 7,
        "title": "🔵 Codes HTTP",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [{
              "kind": "PanelQuery",
              "spec": {
                "hidden": false,
                "refId": "A",
                "query": {
                  "datasource": { "name": "Prometheus" },
                  "group": "prometheus",
                  "kind": "DataQuery",
                  "version": "v0",
                  "spec": {
                    "expr": "sum by(status) (http_requests_total{job=\"obrail_api\"})",
                    "legendFormat": "HTTP {{status}}",
                    "instant": true,
                    "range": false,
                    "editorMode": "code"
                  }
                }
              }
            }],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "piechart",
          "version": "13.0.1+security-01",
          "spec": {
            "options": {
              "pieType": "donut",
              "tooltip": { "mode": "multi", "sort": "none" },
              "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value","percent"] }
            },
            "fieldConfig": {
              "defaults": { "color": { "mode": "palette-classic" } },
              "overrides": []
            }
          }
        }
      }
    }
  },
  "layout": {
    "kind": "GridLayout",
    "spec": {
      "items": [
        { "kind": "GridLayoutItem", "spec": { "element": { "kind": "ElementReference", "name": "panel-1" }, "x": 0,  "y": 0, "width": 4,  "height": 4 } },
        { "kind": "GridLayoutItem", "spec": { "element": { "kind": "ElementReference", "name": "panel-2" }, "x": 4,  "y": 0, "width": 4,  "height": 4 } },
        { "kind": "GridLayoutItem", "spec": { "element": { "kind": "ElementReference", "name": "panel-3" }, "x": 8,  "y": 0, "width": 4,  "height": 4 } },
        { "kind": "GridLayoutItem", "spec": { "element": { "kind": "ElementReference", "name": "panel-4" }, "x": 12, "y": 0, "width": 4,  "height": 4 } },
        { "kind": "GridLayoutItem", "spec": { "element": { "kind": "ElementReference", "name": "panel-5" }, "x": 0,  "y": 4, "width": 14, "height": 8 } },
        { "kind": "GridLayoutItem", "spec": { "element": { "kind": "ElementReference", "name": "panel-6" }, "x": 14, "y": 4, "width": 10, "height": 8 } },
        { "kind": "GridLayoutItem", "spec": { "element": { "kind": "ElementReference", "name": "panel-7" }, "x": 0,  "y": 12, "width": 8,  "height": 6 } }
      ]
    }
  },
  "preferences": {
    "layout": { "kind": "GridLayout", "spec": { "items": [] } }
  },
  "schemaVersion": 38,
  "version": 1
}